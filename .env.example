# Private owner shell only. Never commit real values.
# Exactly 20 secrets, commas or newlines. Leave empty in git.
REDEEM_CODES=

# Long random pepper used to HMAC codes. Changing it invalidates every hash.
GIFT_CODE_PEPPER=

# Existing TeaFairy Supabase project. Service role stays on the server.
SUPABASE_URL=https://lqghuvaazdnqzkbagbay.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the gift functions.
GIFT_ALLOWED_ORIGINS=https://teafairyworld.co.uk,https://www.teafairyworld.co.uk

# Optional. generate-gift-codes.mjs writes here and refuses a path inside the repo.
# GIFT_CODES_OUT=
